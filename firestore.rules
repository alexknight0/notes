rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only Alex's Google account may use the app at all.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email == 'octopus0246@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // users/{uid} (scratch pad, settings) and everything under it (notes).
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // The original single note; kept readable so it can be migrated into the scratch pad.
    match /notes/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
